{
  "name": "@summerscar/dsh-factory",
  "version": "0.0.3",
  "description": "A DSH-native development factory: multi-project kanban boards that dispatch each card into its own session and git worktree, with six bundled phase skills plus a skill that adds a repository as a project, and delivery gated by autonomy tier — human approval at every tier but an explicit auto-delivery tier that stops at a draft PR.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./verdict": "./verdict.js",
    "./delivery": "./delivery.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "state.js",
    "worktree.js",
    "store.js",
    "api.js",
    "commands.js",
    "tools.js",
    "receipt.js",
    "session-context.js",
    "verdict.js",
    "delivery.js",
    "dispatch.js",
    "autonomy.js",
    "ai-copy.js",
    "skills.js",
    "git-exec.js",
    "git-env.js",
    "project-proposal.js",
    "worktree-setup.js",
    "intake.js",
    "sync.js",
    "audit.js",
    "identity.js",
    "github-oauth.js",
    "github-api.js",
    "skills/*/SKILL.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/README.zh-CN.md",
    "docs/dsh-factory-promo.jpg",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "cordis",
    "factory",
    "kanban",
    "board",
    "multi-project",
    "worktree",
    "session",
    "orchestration",
    "pull-request",
    "dsh-plugins"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.16",
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-authorization": ">=0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-authorization": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "catalog": {
      "category": "tool",
      "summary": {
        "en": "A multi-project development factory for DSH: manage projects on kanban boards, dispatch each card into its own session and git worktree, ship six phase skills plus a skill that adds a repository as a project, and gate delivery by autonomy tier — human approval at every tier but an explicit auto-delivery tier that stops at a draft PR.",
        "zh": "面向 DSH 的多项目开发工厂：以看板管理项目，每张卡派发到独立会话与 git worktree，随包提供六个阶段 skill 和一个添加项目的 skill，交付按自治档位设闸——除显式的「自动交付」档止于 draft PR 外，各档都要人工批准。"
      },
      "capabilities": [
        "webServer",
        "slots",
        "locale"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/summerscar/dsh-plugins.git",
    "directory": "plugins/dsh-factory"
  },
  "bugs": {
    "url": "https://github.com/summerscar/dsh-plugins/issues"
